n = int(input("Enter the number: ")) # Changed N to n
book = []
borrow = []

for i in range(n):
    name = input("Enter the name of the book: ")
    book.append(name)
    count = int(input("Enter no of books borrowed: ")) # Added int() conversion
    borrow.append(count)

# Check to ensure n > 0 to avoid crashes on empty lists
if n > 0:
    # Highest and lowest count
    highest = borrow[0]
    lowest = borrow[0]
    highest_book = book[0]
    lowest_book = book[0]
    
    for i in range(1, n):
        if borrow[i] > highest:
            highest = borrow[i]
            highest_book = book[i]
        if borrow[i] < lowest:
            lowest = borrow[i]
            lowest_book = book[i]
            
    print("Highest book count:", highest, "for book:", highest_book)  
    print("Lowest book count:", lowest, "for book:", lowest_book)  

    # Zero borrow count 
    zero = 0
    for i in range(n):
        if borrow[i] == 0:
            zero = zero + 1
    print("Number of members who haven't borrowed any book:", zero) 	
    
    # Average books borrowed 
    total = 0
    for i in range(n):
        total = total + borrow[i]
    avg = total / n
    print("Avg borrowing count:", avg)
    
    # Frequency counter 
    mode = book[0] # Changed to track the book name instead of the count
    max_frequency = 0 # Fixed spelling
    
    for i in range(n):
        frequency = 0
        for j in range(n):
            if borrow[i] == borrow[j]:
                frequency = frequency + 1
        if frequency > max_frequency:
            max_frequency = frequency
            mode = book[i] # Saving the book name
            
    print("Most frequently borrowed book is:", mode)
else:
    print("No books entered.")
