#include <iostream>
#include <string>
#include <algorithm>
#include <limits>
using namespace std;

// Node structure
struct Node
{
    int rollNo;
    string name;
    float marks;
    Node* next;
};

// Head pointer
Node* head = NULL;

// Function to add a student
void addStudent()
{
    Node* newNode = new Node;

    cout << "\nEnter roll number: ";
    cin >> newNode->rollNo;

    cout << "Enter Name: ";
    cin.ignore(numeric_limits<streamsize>::max(), '\n');
    getline(cin, newNode->name);

    cout << "Enter marks: ";
    cin >> newNode->marks;

    newNode->next = NULL;

    // If list is empty
    if (head == NULL)
    {
        head = newNode;
    }
    else
    {
        Node* temp = head;

        while (temp->next != NULL)
        {
            temp = temp->next;
        }

        temp->next = newNode;
    }

    cout << "\nStudent added successfully!\n";
}

// Function to display students
void displayStudents()
{
    if (head == NULL)
    {
        cout << "\nNo student records found\n";
        return;
    }

    Node* temp = head;

    cout << "\n--------------------------------\n";
    cout << "Roll No\tName\t\tMarks\n";
    cout << "--------------------------------\n";

    while (temp != NULL)
    {
        cout << temp->rollNo << "\t";
        cout << temp->name << "\t\t";
        cout << temp->marks << endl;

        temp = temp->next;
    }

    cout << "--------------------------------\n";
}

// Function to search a student
void searchStudent()
{
    if (head == NULL)
    {
        cout << "\nNo student records found\n";
        return;
    }

    int roll;

    cout << "\nEnter Roll Number to search: ";
    cin >> roll;

    Node* temp = head;

    while (temp != NULL)
    {
        if (temp->rollNo == roll)
        {
            cout << "\nStudent found!\n";
            cout << "Roll No: " << temp->rollNo << endl;
            cout << "Name: " << temp->name << endl;
            cout << "Marks: " << temp->marks << endl;

            return;
        }

        temp = temp->next;
    }

    cout << "\nStudent not found\n";
}

// Function to delete a student
void deleteStudent()
{
    if (head == NULL)
    {
        cout << "\nNo student records found\n";
        return;
    }

    int roll;

    cout << "\nEnter roll number to delete: ";
    cin >> roll;

    Node* temp = head;
    Node* prev = NULL;

    // If first node needs to be deleted
    if (temp->rollNo == roll)
    {
        head = temp->next;
        delete temp;

        cout << "\nStudent deleted successfully!\n";
        return;
    }

    // Search for the student
    while (temp != NULL && temp->rollNo != roll)
    {
        prev = temp;
        temp = temp->next;
    }

    if (temp == NULL)
    {
        cout << "\nStudent not found\n";
        return;
    }

    prev->next = temp->next;
    delete temp;

    cout << "\nStudent deleted successfully!\n";
}

// Function to update student details
void updateStudent()
{
    if (head == NULL)
    {
        cout << "\nNo student records found\n";
        return;
    }

    int roll;

    cout << "\nEnter roll number to update: ";
    cin >> roll;

    Node* temp = head;

    while (temp != NULL)
    {
        if (temp->rollNo == roll)
        {
            cout << "Enter new name: ";
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            getline(cin, temp->name);

            cout << "Enter new marks: ";
            cin >> temp->marks;

            cout << "\nStudent record updated successfully!\n";
            return;
        }

        temp = temp->next;
    }

    cout << "\nStudent not found\n";
}

// Function to sort students by marks or roll number
// byMarks = true -> sort by marks
// byMarks = false -> sort by roll number
// ascending = true -> ascending order
// ascending = false -> descending order

void sortStudents(bool byMarks, bool ascending)
{
    if (head == NULL || head->next == NULL)
    {
        cout << "\nNot enough records to sort\n";
        return;
    }

    Node* i;
    Node* j;

    for (i = head; i->next != NULL; i = i->next)
    {
        for (j = i->next; j != NULL; j = j->next)
        {
            bool swapNeeded;

            if (byMarks)
            {
                swapNeeded = ascending ?
                    (i->marks > j->marks) :
                    (i->marks < j->marks);
            }
            else
            {
                swapNeeded = ascending ?
                    (i->rollNo > j->rollNo) :
                    (i->rollNo < j->rollNo);
            }

            if (swapNeeded)
            {
                std::swap(i->rollNo, j->rollNo);
                std::swap(i->name, j->name);
                std::swap(i->marks, j->marks);
            }
        }
    }

    cout << "\nStudents sorted by "
         << (byMarks ? "marks" : "roll number")
         << " in "
         << (ascending ? "ascending" : "descending")
         << " order\n";
}

// Function to ask sorting order
void sortMenu(bool byMarks)
{
    int order;

    cout << "\n1. Ascending";
    cout << "\n2. Descending";
    cout << "\nEnter order: ";

    if (!(cin >> order))
    {
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
        cout << "\nInvalid input!\n";
        return;
    }

    if (order != 1 && order != 2)
    {
        cout << "\nInvalid sorting order!\n";
        return;
    }

    sortStudents(byMarks, order == 1);
    displayStudents();
}

// Function to free allocated memory
void freeMemory()
{
    Node* temp;

    while (head != NULL)
    {
        temp = head;
        head = head->next;
        delete temp;
    }
}

// Main function
int main()
{
    int choice = 0;

    do
    {
        cout << "\n\n===== STUDENT RECORD MANAGEMENT SYSTEM =====";
        cout << "\n1. Add student";
        cout << "\n2. Delete student";
        cout << "\n3. Update student";
        cout << "\n4. Search student";
        cout << "\n5. Display students";
        cout << "\n6. Sort by marks";
        cout << "\n7. Sort by roll number";
        cout << "\n8. Exit";

        cout << "\n\nEnter your choice: ";

        if (!(cin >> choice))
        {
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            cout << "\nInvalid input! Enter a number.\n";
            choice = 0;
            continue;
        }

        switch (choice)
        {
            case 1:
                addStudent();
                break;

            case 2:
                deleteStudent();
                break;

            case 3:
                updateStudent();
                break;

            case 4:
                searchStudent();
                break;

            case 5:
                displayStudents();
                break;

            case 6:
                sortMenu(true);
                break;

            case 7:
                sortMenu(false);
                break;

            case 8:
                cout << "\nProgram terminated\n";
                break;

            default:
                cout << "\nInvalid choice!\n";
        }

    } while (choice != 8);

    freeMemory();

    return 0;
}
